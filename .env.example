# Server-only mail settings. Configure in .env.local or your hosting environment.
# Gmail address used to send the enquiry emails.
GMAIL_USER=
# Gmail App Password (requires 2-Step Verification): https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=
# Optional: defaults to the portfolio email in src/content.ts.
CONTACT_EMAIL_TO=

# Self-hosted analytics (SQLite). Path defaults to ./data/analytics.db (gitignored).
ANALYTICS_DB_PATH=
# HTTP Basic credentials for /admin/analytics. If either is empty, access is denied.
ADMIN_USER=
ADMIN_PASSWORD=
